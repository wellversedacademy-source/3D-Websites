// Cloudflare Workers deployment config for Just hit a LiQ.
// Static assets are served from ./dist; the Worker only runs for /api/*.
// See docs/DEPLOY.md before the first deploy. Nothing here is live until
// `npm run deploy` is run by an account owner.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "just-hit-a-liq",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // Uncomment after `npx wrangler kv namespace create ACCESS_LIST` and paste the id.
  // Without it, /api/access answers 503 and the page says sign-up is not open.
  // "kv_namespaces": [{ "binding": "ACCESS_LIST", "id": "<paste-namespace-id>" }],

  // Custom domain. Leave commented until DNS is approved (docs/DEPLOY.md).
  // "routes": [
  //   { "pattern": "justhitaliq.com", "custom_domain": true },
  //   { "pattern": "www.justhitaliq.com", "custom_domain": true }
  // ],
}
