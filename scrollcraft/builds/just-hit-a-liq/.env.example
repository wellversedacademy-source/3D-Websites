# Copy to .env for local builds. Never commit .env.
#
# Canonical site origin used in canonical URLs, Open Graph tags and the sitemap.
VITE_SITE_ORIGIN=https://justhitaliq.com
#
# Shopify Storefront API (headless). Leave empty until the store exists.
# The Storefront token is a public, read-only token by design, but keep it out
# of git anyway so it can be rotated.
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=
#
# Social links shown in the footer. Leave empty to hide a link.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_X=
#
# Customer care address shown on /care/. Leave empty to show the form-only note.
VITE_CARE_EMAIL=
