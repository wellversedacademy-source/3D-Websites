{
  "env": {
    "SCROLLCRAFT_CHROME": "/opt/pw-browsers/chromium"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && [ -d node_modules/playwright-core ] || npm install --no-audit --no-fund --silent >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ]
  }
}
